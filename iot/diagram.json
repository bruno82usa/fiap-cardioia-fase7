{
  "version": 1,
  "author": "Bruno Gambarini - Grupo 83 FIAP",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    {
      "type": "board-ssd1306",
      "id": "oled",
      "top": -120,
      "left": 100,
      "attrs": { "i2cAddress": "0x3c" }
    },
    {
      "type": "wokwi-potentiometer",
      "id": "pot_bpm",
      "top": 150,
      "left": -120,
      "attrs": { "label": "Simulador BPM" }
    },
    {
      "type": "wokwi-potentiometer",
      "id": "pot_temp",
      "top": 150,
      "left": -10,
      "attrs": { "label": "Simulador Temp" }
    },
    { "type": "wokwi-led", "id": "led_green", "top": -60, "left": -80, "attrs": { "color": "green", "label": "Normal" } },
    { "type": "wokwi-led", "id": "led_red", "top": -60, "left": -30, "attrs": { "color": "red", "label": "Alerta" } },
    { "type": "wokwi-buzzer", "id": "buzzer", "top": -120, "left": -60, "attrs": { "label": "Alarme" } }
  ],
  "connections": [
    [ "esp:TX", "$serial:rx", "", [] ],
    [ "esp:RX", "$serial:tx", "", [] ],
    [ "esp:GND.1", "oled:GND", "black", [ "v0" ] ],
    [ "esp:3V3", "oled:VCC", "red", [ "v0" ] ],
    [ "esp:22", "oled:SCL", "yellow", [ "v0" ] ],
    [ "esp:21", "oled:SDA", "blue", [ "v0" ] ],
    [ "esp:GND.1", "pot_bpm:GND", "black", [ "v0" ] ],
    [ "esp:3V3", "pot_bpm:VCC", "red", [ "v0" ] ],
    [ "esp:34", "pot_bpm:SIG", "green", [ "v0" ] ],
    [ "esp:GND.1", "pot_temp:GND", "black", [ "v0" ] ],
    [ "esp:3V3", "pot_temp:VCC", "red", [ "v0" ] ],
    [ "esp:35", "pot_temp:SIG", "orange", [ "v0" ] ],
    [ "esp:GND.1", "led_green:C", "black", [ "v0" ] ],
    [ "esp:2", "led_green:A", "green", [ "v0" ] ],
    [ "esp:GND.1", "led_red:C", "black", [ "v0" ] ],
    [ "esp:4", "led_red:A", "red", [ "v0" ] ],
    [ "esp:GND.1", "buzzer:1", "black", [ "v0" ] ],
    [ "esp:15", "buzzer:2", "purple", [ "v0" ] ]
  ],
  "dependencies": {}
}
